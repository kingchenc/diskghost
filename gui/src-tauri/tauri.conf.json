{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diskghost",
  "version": "0.11.1",
  "identifier": "org.diskghost.app",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": { "script": "node scripts/build-cli.mjs", "cwd": ".", "wait": true },
    "beforeBuildCommand": { "script": "node scripts/build-cli.mjs", "cwd": "." }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Diskghost 👻",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/diskghost"],
    "windows": {
      "nsis": { "installerHooks": "windows/hooks.nsh" },
      "wix": {
        "fragmentPaths": ["windows/cli-path.wxs"],
        "featureGroupRefs": ["CliOnPathLink"]
      }
    }
  }
}
