<?xml version="1.0" encoding="utf-8"?>
<!-- The MSI installs for all users, so the folder holding the `diskghost` CLI
     (bundle.externalBin) goes on the system PATH; uninstalling removes it. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="CliOnPath" Guid="B75A930A-D803-46B1-BB44-61C542BE1D25">
        <Environment Id="CliOnPath" Name="PATH" Value="[INSTALLDIR]" Action="set"
                     Part="last" System="yes" Permanent="no" />
        <RegistryValue Root="HKLM" Key="Software\Diskghost" Name="CliOnPath"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <!-- Tauri's own "PATH Environment Variable" feature, which installs the
         CLI: unticking it now also leaves the PATH alone. -->
    <FeatureRef Id="Environment">
      <ComponentRef Id="CliOnPath" />
    </FeatureRef>
    <!-- Referenced from tauri.conf.json (featureGroupRefs) so that this
         fragment is linked in. -->
    <FeatureGroup Id="CliOnPathLink" />
  </Fragment>
</Wix>
